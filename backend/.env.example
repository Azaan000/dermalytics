# ========================================================
# DERMALYTICS BACKEND CONFIGURATION TEMPLATE (.env.example)
# ========================================================

# Application Environment (development | staging | production)
# Note: Seed accounts are NOT created when ENVIRONMENT=production
ENVIRONMENT=development
DEBUG=True

# Security (Required: Generate with openssl rand -hex 32)
# App will refuse to start if SECRET_KEY is missing!
SECRET_KEY=generate_with_openssl_rand_hex_32

# Default Seed Account Passwords (Used only in development/testing)
DEMO_USER_PASSWORD=DemoPass123!
ADMIN_USER_PASSWORD=AdminPass123!

# Database Connection URL
DATABASE_URL=sqlite:///./dermalytics.db

# OpenRouter AI Chat Assistant (Configured on server only)
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
