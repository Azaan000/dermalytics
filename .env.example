# Dermalytics Environment Configuration
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME=Dermalytics
VERSION=2.1.0

# Security
SECRET_KEY=dermalytics-super-secure-secret-key-2026-production-ready
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (SQLite for dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./dermalytics.db
# DATABASE_URL=postgresql://postgres:password@localhost:5432/dermalytics

# AI Inference & Saliency Thresholds
MODEL_CONFIDENCE_THRESHOLD=80.0
ENABLE_GRADCAM=true

# Storage
STORAGE_TYPE=local
STORAGE_PATH=./uploads
